{
  "description": "从原生设置添加私网 HTTP T3 执行器，审批凭据留空，再选项目并改派",
  "design": ["DESIGN.md", "design/components/list.md", "design/components/input.md", "design/components/feedback.md"],
  "steps": [
    {"wait": "id:sidebar-account"},
    {"press": "id:sidebar-account"},
    {"press": "id:settings-connections"},
    {"press": "id:executor-add"},
    {"type": ["id:remote-t3-name", "局域网 T3"]},
    {"type": ["id:remote-t3-url", "http://10.77.0.2:23118/mcp"]},
    {"type": ["id:remote-t3-token", "fixture-lan-bearer"]},
    {"select": ["id:remote-t3-mode", "text:完全访问"]},
    {"wait": "id:remote-t3-http-notice"},
    {"screenshot": "http-notice"},
    {"type": ["id:remote-t3-approval", "fixture-device-credential"]},
    {"press": "id:remote-t3-save"},
    {"wait": "id:feedback-error >> text:/审批连接需要本机回环地址或 HTTPS/"},
    {"screenshot": "approval-needs-secure-transport"},
    {"press": "id:feedback-error >> label:关闭提示"},
    {"clear": "id:remote-t3-approval"},
    {"value": ["id:remote-t3-approval", ""]},
    {"press": "id:remote-t3-save"},
    {"screenshot": "save-response"},
    {"gone": "id:remote-t3-editor"},
    {"wait": "label:管理 局域网 T3"},
    {"screenshot": "01-lan-executor"},
    {"press": "label:关闭设置"},
    {"type": ["id:composer-input", "DEEPBOT_VERIFY_WORK"]},
    {"press": "id:composer-send"},
    {"wait": "text:已发起验证事项"},
    {"press": "id:bot-pill"},
    {"press": "label:查看事项 验证事项，验收中"},
    {"wait": "id:work-detail-dialog"},
    {"select": ["id:work-assignee", "text:局域网 T3"]},
    {"press": "id:work-remote-project"},
    {"wait": "text:/lan-project$/"},
    {"screenshot": "02-lan-project"},
    {"press": "text:/lan-project$/"},
    {"wait": "id:work-detail-dialog >> text:/T3 Code fixture 中文结果/"},
    {"screenshot": "03-lan-result"}
  ]
}
