{
  "description": "验证连接唯一入口、T3 档位、Bot 自己的执行偏好及 MCP 授权表单",
  "design": ["DESIGN.md", "design/components/list.md", "design/components/dialog.md", "design/components/input.md", "design/components/select.md"],
  "steps": [
    {"wait": "id:sidebar-account"},
    {"press": "id:sidebar-account"},
    {"wait": "id:settings-connections"},
    {"press": "id:settings-connections"},
    {"wait": "id:connector-t3code"},
    {"gone": "id:settings-executor"},
    {"gone": "id:settings-connectors"},
    {"wait": "id:mcp-add >> text:暂无连接器"},
    {"screenshot": "01-connectors"},
    {"press": "id:t3-configure"},
    {"wait": "id:t3-token-editor"},
    {"press": "id:t3-token-cancel"},
    {"gone": "id:t3-token-editor"},
    {"press": "id:t3-configure"},
    {"wait": "id:t3-token-editor"},
    {"screenshot": "02-t3-editor"},
    {"select": ["id:t3-runtime-mode", "text:逐次审批"]},
    {"press": "id:t3-token-save"},
    {"gone": "id:t3-token-editor"},
    {"wait": "id:t3-mode-status >> text:/逐次审批/"},
    {"wait": "id:feedback-success"},
    {"press": "id:feedback-success >> label:关闭提示"},
    {"screenshot": "03-t3-mode-saved"},
    {"press": "id:self-configure"},
    {"select": ["id:executor-thinking", "text:高"]},
    {"screenshot": "04-self"},
    {"press": "id:self-configure"},
    {"press": "id:mcp-add"},
    {"wait": "id:mcp-editor"},
    {"screenshot": "05-mcp-editor"},
    {"press": "id:mcp-bots"},
    {"press": "label:小菜"},
    {"press": "id:mcp-bots-done"},
    {"press": "label:新建 Bot 默认可用"},
    {"screenshot": "06-mcp-access"},
    {"press": "id:mcp-cancel"},
    {"gone": "id:mcp-editor"}
  ]
