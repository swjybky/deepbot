    {"clear": "id:mcp-url"},
    {"type": ["id:mcp-url", "http://127.0.0.1:23115/alpha"]},
    {"press": "id:mcp-bots"},
    {"press": "label:小菜"},
    {"press": "id:mcp-bots-done"},
    {"press": "label:新建 Bot 默认可用"},
    {"screenshot": "02-grant"},
    {"press": "id:mcp-save"},
    {"gone": "id:mcp-editor"},
    {"wait": "id:feedback-success"},
    {"press": "id:feedback-success >> label:关闭提示"},
    {"wait": "label:管理 验收甲"},
    {"press": "id:mcp-add"},
    {"type": ["id:mcp-name", "验收乙"]},
    {"type": ["id:mcp-url", "http://127.0.0.1:23115/beta"]},
    {"press": "id:mcp-save"},
    {"gone": "id:mcp-editor"},
    {"wait": "id:feedback-success"},
    {"press": "id:feedback-success >> label:关闭提示"},
    {"wait": "label:管理 验收乙"},
    {"wait": "id:mcp-bot-access >> text:1 个"},
    {"wait": "id:mcp-bot-access >> text:未授权"},
    {"screenshot": "03-two-services"},
    {"press": "label:管理 验收甲"},
    {"press": "id:mcp-bots"},
    {"press": "label:小菜"},
    {"press": "id:mcp-bots-done"},
    {"press": "label:新建 Bot 默认可用"},
    {"press": "id:mcp-save"},
    {"gone": "id:mcp-editor"},
    {"wait": "id:feedback-success"},
    {"press": "id:feedback-success >> label:关闭提示"},
    {"gone": "id:mcp-bot-access >> text:1 个"},
    {"press": "label:管理 验收甲"},
    {"press": "id:mcp-connect"},
    {"gone": "id:mcp-editor"},
    {"wait": "id:feedback-success"},
    {"press": "id:feedback-success >> label:关闭提示"},
    {"wait": "id:mcp-grid >> text:已断开"},
    {"screenshot": "04-disconnected"},
    {"press": "label:管理 验收甲"},
    {"press": "id:mcp-connect"},
    {"gone": "id:mcp-editor"},
    {"wait": "id:feedback-success"},
    {"press": "id:feedback-success >> label:关闭提示"},
    {"gone": "id:mcp-grid >> text:已断开"},
    {"screenshot": "05-reconnected"}
  ]
