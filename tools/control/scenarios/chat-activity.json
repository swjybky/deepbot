{
  "description": "用隔离模型驱动真实前台工具、事项派发、流式回复及异常，验证两个 Bot 的运行状态",
  "design": ["design/layout.md", "design/components/feedback.md"],
  "steps": [
    {"wait": "label:查看 小菜 的信息"},
    {"press": "id:sidebar-create"},
    {"type": ["id:create-bot-name", "隔离助手"]},
    {"press": "id:create-bot-submit"},
    {"gone": "id:create-bot"},
    {"wait": "label:查看 隔离助手 的信息"},
    {"press": "id:bot-xiaocai"},
    {"wait": "label:查看 小菜 的信息"},
    {"type": ["id:composer-input", "DEEPBOT_VERIFY_CHAT_ACTIVITY"]},
    {"press": "id:composer-send"},
    {"wait": "text:正在思考"},
    {"screenshot": "01-thinking"},
    {"wait": "text:正在使用工具"},
    {"screenshot": "02-tool"},
    {"press": "id:sidebar-list-zone >> text:隔离助手"},
    {"wait": "label:查看 隔离助手 的信息"},
    {"gone": "id:bot-typing"},
    {"screenshot": "03-other-idle"},
    {"press": "id:bot-xiaocai"},
    {"wait": "text:正在使用工具"},
    {"screenshot": "04-back-to-tool"},
    {"wait": "text:正在安排事项"},
    {"screenshot": "05-dispatch"},
    {"wait": "text:正在组织回复"},
    {"screenshot": "06-replying"},
    {"wait": "text:运行阶段验证结束"},
    {"gone": "id:bot-typing"},
    {"press": "id:bot-pill"},
    {"wait": "label:查看事项 运行阶段验证事项，执行中"},
    {"screenshot": "07-replied-background-running"},
    {"press": "id:bot-pill"},
    {"type": ["id:composer-input", "DEEPBOT_VERIFY_CHAT_FAILURE"]},
    {"press": "id:composer-send"},
    {"wait": "text:正在思考"},
    {"wait": "id:feedback-error"},
    {"gone": "id:bot-typing"},
    {"screenshot": "08-failed-idle"}
  ]
}
