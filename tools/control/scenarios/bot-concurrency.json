{
  "description": "从两个 Bot 的配置页验证事项并发默认值、输入校验和独立保存",
  "design": ["DESIGN.md", "design/components/input.md", "design/components/feedback.md"],
  "steps": [
    {"wait": "id:bot-xiaocai"},
    {"press": "id:bot-pill"},
    {"wait": "id:bot-info"},
    {"press": "text:配置"},
    {"value": ["id:bot-config-max-concurrent", "10"]},
    {"screenshot": "01-default"},
    {"clear": "id:bot-config-max-concurrent"},
    {"type": ["id:bot-config-max-concurrent", "0"]},
    {"submit": "id:bot-config-max-concurrent"},
    {"wait": "id:feedback-error"},
    {"value": ["id:bot-config-max-concurrent", "10"]},
    {"press": "id:feedback-error >> label:关闭提示"},
    {"clear": "id:bot-config-max-concurrent"},
    {"type": ["id:bot-config-max-concurrent", "2"]},
    {"submit": "id:bot-config-max-concurrent"},
    {"press": "id:sidebar-create"},
    {"wait": "id:create-bot"},
    {"type": ["id:create-bot-name", "并发验证 Bot"]},
    {"press": "id:create-bot-submit"},
    {"gone": "id:create-bot"},
    {"wait": "label:查看 并发验证 Bot 的信息"},
    {"value": ["id:bot-config-max-concurrent", "10"]},
    {"clear": "id:bot-config-max-concurrent"},
    {"type": ["id:bot-config-max-concurrent", "4"]},
    {"clear": "id:bot-config-instructions"},
    {"press": "label:打开 小菜"},
    {"press": "text:配置"},
    {"value": ["id:bot-config-max-concurrent", "2"]},
    {"screenshot": "02-first-bot"},
    {"press": "id:sidebar-list-zone >> text:并发验证 Bot"},
    {"press": "text:配置"},
    {"value": ["id:bot-config-max-concurrent", "4"]},
    {"screenshot": "03-second-bot"}
  ]
}
