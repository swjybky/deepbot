{
  "description": "真实 sidecar 刷新期间保留重命名草稿，验证原值、键入、删除、保存、取消和切换目标",
  "design": ["design/components/input.md", "design/components/dialog.md", "design/sidebar.md"],
  "steps": [
    {"wait": "id:bot-xiaocai"},
    {"press": "id:sidebar-create"},
    {"type": ["id:create-bot-name", "隔离助手"]},
    {"press": "id:create-bot-submit"},
    {"gone": "id:create-bot"},
    {"wait": "label:查看 隔离助手 的信息"},
    {"press": "id:bot-xiaocai"},
    {"type": ["id:composer-input", "DEEPBOT_VERIFY_CHAT_ACTIVITY"]},
    {"press": "id:composer-send"},
    {"wait": "text:正在使用工具"},
    {"rightClick": "id:sidebar-list-zone >> text:隔离助手"},
    {"chooseMenuItem": "重命名 Bot"},
    {"wait": "id:rename-bot-name"},
    {"value": ["id:rename-bot-name", "隔离助手"]},
    {"type": ["id:rename-bot-name", "ab"]},
    {"key": "backspace"},
    {"value": ["id:rename-bot-name", "隔离助手a"]},
    {"screenshot": "01-edited"},
    {"wait": "text:已发起运行阶段验证事项"},
    {"screenshot": "02-refreshed"},
    {"value": ["id:rename-bot-name", "隔离助手a"]},
    {"submit": "id:rename-bot-name"},
    {"gone": "id:rename-bot-name"},
    {"wait": "id:sidebar-list-zone >> text:隔离助手a"},
    {"rightClick": "id:sidebar-list-zone >> text:隔离助手a"},
    {"chooseMenuItem": "重命名 Bot"},
    {"value": ["id:rename-bot-name", "隔离助手a"]},
    {"type": ["id:rename-bot-name", "x"]},
    {"press": "id:rename-bot >> text:取消"},
    {"gone": "id:rename-bot-name"},
    {"rightClick": "id:bot-xiaocai"},
    {"chooseMenuItem": "重命名 Bot"},
    {"value": ["id:rename-bot-name", "小菜"]},
    {"press": "id:rename-bot >> text:取消"},
    {"gone": "id:rename-bot-name"},
    {"rightClick": "id:sidebar-list-zone >> text:隔离助手a"},
    {"chooseMenuItem": "重命名 Bot"},
    {"value": ["id:rename-bot-name", "隔离助手a"]},
    {"screenshot": "03-reopened"}
  ]
}
