{
  "name": "deepbot",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nsh run apps/desktop",
    "check": "node tools/control/cli.mjs check",
    "agent": "pnpm --filter @deepbot/agent start",
    "verify": "node tools/control/cli.mjs",
    "test": "pnpm --filter @deepbot/agent test && nsh test apps/desktop",
    "test:ui": "nsh test apps/desktop"
  }
}
